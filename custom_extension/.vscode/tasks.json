{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build everything",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build",
				"&&",
				"npm",
				"run",
				"test:compile",
				"--ws"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "pre-build",
			"type": "npm",
			"script": "watch",
			"problemMatcher":[
				"$ts-webpack-watch"
			],
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "watchers"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "VSCE Package",
			"type": "shell",
			"command": "vsce",
			"args": [
				"package"
			]
		}
	]
}