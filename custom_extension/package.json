    "@types/fs-extra": "^11.0.1",
    "@vscode/extension-telemetry": "^0.8.3",
    "fs-extra": "^11.1.1",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  }
